     packet_handler(hci_packet[0], &hci_packet[1], read_pos-1);
@@ -292,6 +313,12 @@ static void h4_process(btstack_data_source_t *ds, btstack_data_source_callback_type_t callback_type) {
     ssize_t bytes_read = read(hci_transport_h4->uart_fd, &hci_packet[read_pos], read_now);
     if (bytes_read < 0) {
@@
         return;
     }
+    if (bytes_read == 0) {
+        log_error("h4_6s: controller transport returned EOF while waiting for HCI data");
+        return;
+    }
