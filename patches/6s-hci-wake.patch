@@ -53,8 +53,8 @@
 #define SETSOCKOPT_VAL    0x80487414  /* from reversing BTServer */
 #endif
 
-// don't enforce wake after 3s idle
+// Keep the controller awake after a packet, and give older controllers more
+// time to settle after opening /dev/btwake.
 #define HCI_WAKE_TIMER_MS 3000
-#define HCI_WAKE_DURATION 10000
+#define HCI_WAKE_DURATION 100000
 
 #include <errno.h>
 #include <termios.h>  /* POSIX terminal control definitions */
@@ -95,6 +95,22 @@ static int read_pos;
 
 static uint8_t hci_packet[1+HCI_INCOMING_PACKET_BUFFER_SIZE]; // packet type + max(acl header + acl payload, event header + event data)
 
+static void h4_6s_log_packet(const char *direction, uint8_t packet_type,
+                             const uint8_t *packet, int size){
+    int dump = size > 16 ? 16 : size;
+    char hex[16 * 3 + 1];
+    int pos = 0;
+    for (int i = 0; i < dump; i++){
+        pos += snprintf(&hex[pos], sizeof(hex) - (size_t)pos, "%02x%s",
+                        packet[i], i + 1 == dump ? "" : " ");
+    }
+    hex[pos] = '\0';
+    log_info("h4_6s %s type=0x%02x size=%d data=%s",
+             direction, packet_type, size, hex);
+}
+
 static void h4_init(const void * transport_config){
@@ -151,6 +167,7 @@ static int h4_open(void)
         goto err_out2;
     }
     log_info("h4_open: connect to socket ok");
+    log_info("h4_6s: legacy H4 transport attached to %s", SOCKET_DEVICE);
     
     // configure UART
@@ -218,8 +235,10 @@ static int h4_send_packet(uint8_t packet_type, uint8_t * packet, int size){
 
     // wake Bluetooth module
     h4_enforce_wake_on();
+    log_info("h4_6s: sending HCI packet after wake type=0x%02x size=%d",
